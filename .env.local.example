# Local development template for docker-compose.yml.
# Copy to .env.local when you need machine-specific overrides.

OPENAI_API_KEY=dev-openai-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini
MEETING_SUMMARY_LANGUAGE=en
MEETING_SUMMARY_MAX_SOURCE_ITEMS=240

REDIS_URL=redis://redis:6379/0

MONGODB_URL=
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_DATABASE=brseai
MONGODB_USERNAME=brseai_app
MONGODB_PASSWORD=dev-mongodb-password
MONGODB_AUTH_SOURCE=brseai
MONGODB_ROOT_USERNAME=brseai_root
MONGODB_ROOT_PASSWORD=dev-mongodb-root-password
MONGODB_SERVER_SELECTION_TIMEOUT_MS=500
MONGODB_CONNECT_TIMEOUT_MS=500

ROOM_JWT_SECRET=dev-room-secret
ROOM_TOKEN_TTL_SECONDS=86400
ROOM_MEETING_DURATION_SECONDS=1800
ROOM_MAX_PARTICIPANTS=0

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devkeysecretdevkeysecretdevkey12
LIVEKIT_WS_URL_PUBLIC=ws://localhost:7880
LIVEKIT_WS_URL_INTERNAL=ws://livekit:7880

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:8000
PUBLIC_GATEWAY_WS_URL=

REALTIME_INPUT_SAMPLE_RATE=24000
REALTIME_OUTPUT_SAMPLE_RATE=24000
# Per-speaker line isolation: mutes acoustic bleed between co-located mics
LIVEKIT_LINE_ISOLATION_ENABLED=true
LIVEKIT_LINE_LOOKAHEAD_MS=120
LIVEKIT_LINE_CROSSTALK_CORRELATION=0.75
LIVEKIT_LINE_CROSSTALK_DOMINANCE_DB=4.0
LOG_LEVEL=INFO
# Log raw meeting transcript/relay text (local debugging only). Default: lengths only.
LOG_TRANSCRIPTS=false

TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFY_ROOM_CREATED=true
TELEGRAM_NOTIFY_PARTICIPANT_JOINED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=3

# Admin portal (/admin/login): username + password, separate from Google sign-in.
# Disabled until ADMIN_USERNAME and a password are set. Generate the hash with:
#   docker compose exec gateway python -m server.service.auth.passwords
ADMIN_USERNAME=dev-admin
ADMIN_PASSWORD_HASH=
# Plain-text alternative for local development only (ignored when ADMIN_PASSWORD_HASH is set).
ADMIN_PASSWORD=dev-admin-password
ADMIN_SESSION_TTL_SECONDS=43200

# User sign-in with Google (docs/google-login-setup.md). Same client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional: only these email domains may sign in (comma-separated). Empty = any verified Google account.
GOOGLE_ALLOWED_DOMAINS=
USER_SESSION_TTL_SECONDS=1209600
# Room/test endpoints require a signed-in user.
USER_AUTH_REQUIRED=true
# Session cookies are Secure; set false only for a plain-http setup other than localhost.
AUTH_COOKIE_SECURE=false
# Retention for BRSE ops events (relay traces / AI errors) in MongoDB.
OPS_EVENT_RETENTION_DAYS=30

# Exact frontend origins allowed to call the API with session cookies (comma-separated, never "*").
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Meeting recording + archive: docker-compose.yml runs RustFS (S3) and LiveKit Egress locally;
# these defaults need no changes. Browser playback URLs point at http://localhost:9000.
# MEETING_ARCHIVE_BUCKET=meetq-archive-local
# DEFAULT_MEETING_RETENTION_DAYS=7
