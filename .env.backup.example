# MeetQ database backup tool (tools/db_backup). Copy to .env.backup (git-ignored):
#   cp .env.backup.example .env.backup && chmod 600 .env.backup
# Never commit real values. Real environment variables override this file.

# Which environment this machine backs up: dev | staging | prod.
# Backups go to s3://$DB_BACKUP_S3_BUCKET/$DB_BACKUP_S3_PREFIX/$BACKUP_ENVIRONMENT/...
BACKUP_ENVIRONMENT=dev

# Source database (MongoDB). Use a dedicated read-only backup user.
#   mongodb://backup_user:PASSWORD@db.example.internal:27017/brseai?authSource=admin
# Alternatively MONGODB_HOST/MONGODB_PORT/MONGODB_DATABASE/MONGODB_USERNAME/MONGODB_PASSWORD/MONGODB_AUTH_SOURCE.
DATABASE_URL=

# Restore target (never defaults to DATABASE_URL). Local example:
#   mongodb://localhost:27017/brseai_restore
RESTORE_DATABASE_URL=

# AWS: standard credential chain. On a laptop use a profile; on EC2/ECS use the instance/task role.
AWS_REGION=ap-southeast-1
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_PREFIX=database-backups

BACKUP_TMP_DIR=/tmp/meetq-db-backup
KEEP_LOCAL_BACKUP=false
BACKUP_RETENTION_DAYS=30
MIN_BACKUPS_TO_KEEP=3
RESTORE_JOBS=4

# Run mongodump/mongorestore in the official mongo image instead of local binaries.
BACKUP_USE_DOCKER=false
BACKUP_DOCKER_NETWORK=host

# Optional: message the existing MeetQ Telegram chat when a backup fails.
BACKUP_NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
