# Frontend build settings for `make deploy-prod`. Copy to config/frontend/prod.env.
# These values are compiled into the public JavaScript bundle: never put secrets here
# (no Google client secret, no API keys, no passwords).
#
# VITE_APP_ORIGIN is NOT set here: deploy.sh takes it from Terraform (frontend_url).

# Backend API, deployed separately (any platform).
VITE_API_BASE_URL=https://api.meetq.example.com
# Optional: defaults to VITE_API_BASE_URL with https -> wss.
VITE_WS_BASE_URL=wss://api.meetq.example.com
# LiveKit server used by meetings.
VITE_LIVEKIT_WS_URL=wss://rtc.meetq.example.com

# Google Identity Services web client ID (public). See docs/google-login-setup.md.
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
