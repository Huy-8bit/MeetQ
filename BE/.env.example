# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini
MEETING_SUMMARY_LANGUAGE=en
MEETING_SUMMARY_MAX_SOURCE_ITEMS=240

# Redis
REDIS_URL=redis://localhost:6379

# MongoDB historical archive auth.
# Leave MONGODB_URL empty to build a credentialed URI from the fields below.
# If set, MONGODB_URL must include credentials, for example:
# MONGODB_URL=mongodb://brseai_app:your_mongodb_app_password@localhost:27017/brseai?authSource=brseai
MONGODB_URL=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=brseai
MONGODB_USERNAME=brseai_app
MONGODB_PASSWORD=your_mongodb_app_password
MONGODB_AUTH_SOURCE=brseai
MONGODB_SERVER_SELECTION_TIMEOUT_MS=500
MONGODB_CONNECT_TIMEOUT_MS=500

# JWT
ROOM_JWT_SECRET=your_jwt_secret_here
ROOM_TOKEN_TTL_SECONDS=86400
ROOM_MEETING_DURATION_SECONDS=1800
ROOM_MAX_PARTICIPANTS=0

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL_PUBLIC=ws://localhost:7880
LIVEKIT_WS_URL_INTERNAL=ws://localhost:7880

# Public URLs
# Local dev defaults:
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:8000
PUBLIC_GATEWAY_WS_URL=
# Production values:
# PUBLIC_APP_URL=https://meetqapp.com
# PUBLIC_GATEWAY_URL=https://meetqapp.com
# PUBLIC_GATEWAY_WS_URL=wss://meetqapp.com
# LIVEKIT_WS_URL_PUBLIC=wss://rtc.meetqapp.com

REALTIME_INPUT_SAMPLE_RATE=24000
REALTIME_OUTPUT_SAMPLE_RATE=24000

# Telegram notifications (optional)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFY_ROOM_CREATED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=3
