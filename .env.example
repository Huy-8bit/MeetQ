# Production deploy template for docker-compose.prod.yml.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
MEETING_SUMMARY_LANGUAGE=en
MEETING_SUMMARY_MAX_SOURCE_ITEMS=240
ROOM_JWT_SECRET=replace-with-strong-room-jwt-secret
ROOM_TOKEN_TTL_SECONDS=86400
ROOM_MEETING_DURATION_SECONDS=1800
ROOM_MAX_PARTICIPANTS=0

# MongoDB historical archive auth.
# Leave MONGODB_URL empty to build a credentialed URI from the fields below.
# If set, MONGODB_URL must include credentials, for example:
# MONGODB_URL=mongodb://brseai_app:replace-with-mongodb-password@mongo:27017/brseai?authSource=brseai
MONGODB_URL=
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_DATABASE=brseai
MONGODB_USERNAME=replace-with-mongodb-app-username
MONGODB_PASSWORD=replace-with-mongodb-app-password
MONGODB_AUTH_SOURCE=brseai
MONGODB_ROOT_USERNAME=replace-with-mongodb-root-username
MONGODB_ROOT_PASSWORD=replace-with-mongodb-root-password
MONGODB_SERVER_SELECTION_TIMEOUT_MS=500
MONGODB_CONNECT_TIMEOUT_MS=500

LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_WS_URL_PUBLIC=wss://rtc.meetqapp.com
LIVEKIT_WS_URL_INTERNAL=ws://livekit:7880

PUBLIC_APP_URL=https://meetqapp.com
PUBLIC_GATEWAY_URL=https://meetqapp.com
PUBLIC_GATEWAY_WS_URL=wss://meetqapp.com
VITE_API_BASE_URL=

REALTIME_INPUT_SAMPLE_RATE=16000
REALTIME_OUTPUT_SAMPLE_RATE=24000
LOG_LEVEL=INFO
SSL_CERTS_DIR=/etc/letsencrypt

# Telegram notifications (optional)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFY_ROOM_CREATED=true
TELEGRAM_NOTIFY_PARTICIPANT_JOINED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=3
